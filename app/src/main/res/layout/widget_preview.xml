<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the home-screen widget picker. Mirrors DoseWidget's 4x2 layout for an
  hour that holds several doses: the hour header, "All", and one line per dose with the app's
  cookie/clover shapes. Uses the device's Material You tonal palette so it matches the real widget.
  ponytail: system tonal tokens don't invert for dark mode, so this preview always renders light.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/system_neutral1_50"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2:00 PM · 3 doses"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/system_neutral1_900" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tap one to open it"
                android:textSize="13sp"
                android:textColor="@android:color/system_neutral2_500" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_circle"
            android:backgroundTint="@android:color/system_accent1_600"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_neutral1_50" />
    </LinearLayout>

    <!-- Dose 1 — pending -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_preview_card"
        android:backgroundTint="@android:color/system_neutral2_100"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vitamin D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_neutral1_900" />
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_shape_cookie7"
                android:tint="@android:color/system_accent1_100" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_circle"
                android:tint="@android:color/system_accent1_900" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dose 2 — pending -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_preview_card"
        android:backgroundTint="@android:color/system_neutral2_100"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Metformin"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_neutral1_900" />
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_shape_cookie7"
                android:tint="@android:color/system_accent1_100" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_circle"
                android:tint="@android:color/system_accent1_900" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dose 3 — taken -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_preview_card"
        android:backgroundTint="#D9EBD6"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingVertical="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Magnesium"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#12401A" />
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_shape_clover8"
                android:tint="@color/dose_taken" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_check"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
